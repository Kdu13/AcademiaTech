# Copie este arquivo para .env e substitua os exemplos pelas suas configurações.
DJANGO_SECRET_KEY=gere-uma-chave-secreta-forte-para-o-django
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Vazio no desenvolvimento mantém o SQLite local.
# Na hospedagem, configure a URI PostgreSQL do Supabase.
DATABASE_URL=
SQLITE_PATH=

# Use a chave secreta do projeto Supabase apenas no servidor.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=cole-a-chave-secreta-do-supabase
SUPABASE_BUCKET=cursos

# Cotação de contingência aplicada caso a AwesomeAPI esteja indisponível.
USD_BRL_FALLBACK=5.50

# Em desenvolvimento, a redefinição de senha aparece no terminal.
# Em produção, configure um servidor SMTP autorizado.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Academia Tech <no-reply@example.com>

# Opcional: usado pelo comando popular_academia_tech para criar cliente_demo.
ACADEMIA_DEMO_PASSWORD=
